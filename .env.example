# CareFusion AI - safe demo values only. Copy to .env (never commit .env).

# Database
POSTGRES_USER=carefusion
POSTGRES_PASSWORD=cf_demo_password_change_me
POSTGRES_DB=carefusion
DATABASE_URL=postgresql://carefusion:cf_demo_password_change_me@db:5432/carefusion

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=kc_demo_password_change_me
KC_DB_URL=jdbc:postgresql://db:5432/carefusion?currentSchema=public

# Keycloak OIDC (for the API)
KEYCLOAK_REALM=carefusion
KEYCLOAK_CLIENT_ID=carefusion-web
KEYCLOAK_API_CLIENT_ID=carefusion-api
KEYCLOAK_API_CLIENT_SECRET=api-demo-secret-change-me
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Valkey (Redis-compatible)
VALKEY_URL=redis://valkey:6379

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_demo_password_change_me
MINIO_ENDPOINT=http://localstack:4566
# Host the browser uses to open pre-signed download links
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=carefusion-files

# AI Service
AI_SERVICE_URL=http://ai:8000

# App
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
DEMO_MODE=true

# Freeze the demo clock (seed data is dated 17 Oct 2026); leave blank to use the real clock
DEMO_NOW=2026-10-17T14:45:00+05:30

# Object storage region. LocalStack default is ap-south-1; use "auto" for Cloudflare R2.
# MINIO_REGION=auto

# Optional: per-role reviewer passwords for a public demo (JSON, passwords 8+ characters). Roles listed here must
# sign in with their password and get a signed 8-hour token; unlisted roles stay open. Needs ACCESS_KEY_SECRET (16+ chars).
# REVIEWER_PASSWORDS={"DOCTOR":"change-me-1","CENTRAL_ADMIN":"change-me-2"}

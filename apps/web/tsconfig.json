{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "declaration": false,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@carefusion/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src"]
}
